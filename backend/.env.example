# Copy to backend/.env and fill in.
GEMINI_API_KEY=

# Gemini 4 models visible to the hackathon key: gemini-4-argon, gemini-4-carbon, gemini-4-hydrogen.
# Hydrogen was fastest in a quick test (3.5 s vs 5.6-6.2 s); Argon/Carbon assumed heavier.
GEMINI_MODEL_FAST=gemini-4-hydrogen
GEMINI_MODEL_PRO=gemini-4-argon

# Parallel LLM calls (lower this if you hit 429s).
MAX_CONCURRENCY=12
# Pages per PDF chunk sent to one extractor agent.
CHUNK_PAGES=20
# Hard cap per document (e.g. the 734-page interview compilation). 0 = no cap.
MAX_PAGES_PER_DOC=200

# 1 = force the offline mock extractor (regex based) even if a key is set.
MOCK_LLM=0

# Where cases and dockets are stored.
DATA_DIR=../data
