# Copy to backend/.env and fill in.
GEMINI_API_KEY=

# Gemini models your key can access: a fast one for triage/images, a stronger one for heavy extraction.
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=

# Parallel LLM calls (lower this if you hit 429s).
MAX_CONCURRENCY=32
# Pages per PDF chunk sent to one extractor agent.
CHUNK_PAGES=20
# Hard cap per document (e.g. the 734-page interview compilation). 0 = no cap.
MAX_PAGES_PER_DOC=200

# 1 = force the offline mock extractor (regex based) even if a key is set.
MOCK_LLM=0

# Where dockets (GBs) and case outputs are stored. Keep this OUTSIDE the repo and outside
# synced folders (OneDrive, Dropbox). Default if unset: ~/DocketBlueprintData
# DATA_DIR=C:\Users\<you>\DocketBlueprintData
# Extra folders "Analyse local folder" may read besides DATA_DIR (os.pathsep separated: ';' on Windows).
# LOCAL_CASE_ROOTS=D:\dockets
# Browser origins allowed to call the API (the Vite dev proxy needs none).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum seconds for one Gemini generation/upload/status request (retries are separate).
GEMINI_REQUEST_TIMEOUT_S=480

# Intake demo: replay this completed saved case instead of starting extraction.
DEMO_MODE=0
DEMO_CASE_ID=atlas-team-reviewed-v1
